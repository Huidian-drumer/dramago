{
  "name": "dramago-creative-workbench",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "local:start": "node scripts/build.mjs && node local/server.mjs --open",
    "local:serve": "node scripts/build.mjs && node local/server.mjs --no-open",
    "qa:windows-local": "node scripts/build.mjs && node scripts/qa-windows-local.mjs",
    "qa:windows-desktop": "node scripts/build.mjs && node scripts/qa-windows-desktop.mjs",
    "qa:windows-desktop:real": "node scripts/build.mjs && node scripts/qa-windows-desktop-real.mjs",
    "desktop:start": "node scripts/build.mjs && electron .",
    "desktop:compat": "node scripts/build.mjs && electron . --desktop-compatibility-output=reports/windows-desktop-packaging-v1/development-compatibility.json",
    "desktop:package": "node scripts/build.mjs && node scripts/package-windows-portable.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "audit:l2": "npm run build && node audit/run-wrapper-audit.mjs",
    "db:validate": "node audit/validate-migrations.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "claims:validate": "node scripts/validate-public-claims.mjs",
    "links:validate": "node scripts/validate-repository-links.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "drizzle-kit": "0.31.10",
    "electron": "44.7.0",
    "playwright-core": "^1.64.0"
  }
}
